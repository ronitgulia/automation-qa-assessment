    {
      "parameters": {
        "url": "https://api.github.com/search/repositories",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "automation"
            },
            {
              "name": "sort",
              "value": "stars"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "15"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "870d07a9-fa69-4fa1-be77-9a41054aff73",
      "name": "1. Fetch Trending GitHub Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -176,
        80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PrWsSHPcYS1nnpwj",
          "name": "Header Auth account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const rawItems = $input.first().json.items || [];\n\nconst top5 = rawItems\n  .filter(repo => !repo.archived && !repo.disabled)\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5)\n  .map((repo, idx) => ({\n    json: {\n      rank: idx + 1,\n      name: repo.name,\n      full_name: repo.full_name,\n      html_url: repo.html_url,\n      description: repo.description || 'No description provided',\n      stars: repo.stargazers_count,\n      forks: repo.forks_count,\n      open_issues: repo.open_issues_count,\n      language: repo.language || 'Unknown'\n    }\n  }));\n\nif (top5.length === 0) {\n  throw new Error('No active repositories returned after filtering.');\n}\n\nreturn top5;"
      },
      "id": "161d813b-d190-4512-b7e1-33463684b788",
      "name": "2. Filter & Keep Top 5 Repos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        -16
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.full_name }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "per_page",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "e2f66b0f-1021-42dc-937d-ad8b5c3bdc0d",
      "name": "3. Enrich with Latest Commit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        352,
        -16
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PrWsSHPcYS1nnpwj",
          "name": "Header Auth account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const enriched = [];\nconst sourceRepos = $('2. Filter & Keep Top 5 Repos').all();\nconst commitResponses = $input.all();\n\nfor (let i = 0; i < commitResponses.length; i++) {\n  const repo = sourceRepos[i] ? sourceRepos[i].json : {};\n  const commitData = Array.isArray(commitResponses[i].json) ? commitResponses[i].json[0] : commitResponses[i].json;\n  const commitObj = commitData?.commit || {};\n\n  enriched.push({\n    json: {\n      ...repo,\n      latest_commit_author: commitObj?.author?.name || 'Unknown',\n      latest_commit_date: commitObj?.author?.date || 'N/A',\n      latest_commit_msg: (commitObj?.message || 'No commit message').split('\\n')[0]\n    }\n  });\n}\n\nreturn enriched;"
      },
      "id": "09c1a412-9057-4791-92e5-cdedd0bfc092",
      "name": "4. Merge Repo & Commit Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        -64
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "stars-threshold-check",
              "leftValue": "={{ $json.stars }}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b4835406-f881-4c29-b0a4-7648c9d310c3",
      "name": "5. IF Stars > 1000",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        832,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst lines = items.map(r => `🔥 *#${r.rank} ${r.full_name}* (⭐ ${r.stars} | 🍴 ${r.forks})\\n   • Latest Commit: \"${r.latest_commit_msg}\" by ${r.latest_commit_author}\\n   • Link: ${r.html_url}`);\n\nreturn [{\n  json: {\n    tier: 'HIGH_TRACTION (>1000 Stars)',\n    count: items.length,\n    content: `🌅 **Morning Brief — High-Traction Repos (⭐ > 1,000)**\\n\\n${lines.join('\\n\\n')}`\n  }\n}];"
      },
      "id": "4589b567-49e9-483b-9284-e938ce75a176",
      "name": "Format High-Traction Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        -176
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst lines = items.map(r => `🌱 *#${r.rank} ${r.full_name}* (⭐ ${r.stars})\\n   • Latest Commit: \"${r.latest_commit_msg}\"\\n   • Link: ${r.html_url}`);\n\nreturn [{\n  json: {\n    tier: 'RISING_WATCHLIST (<=1000 Stars)',\n    count: items.length,\n    content: `📋 **Morning Brief — Rising Watchlist (⭐ <= 1,000)**\\n\\n${lines.join('\\n\\n')}`\n  }\n}];"
      },
