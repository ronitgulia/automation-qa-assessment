      },
      "id": "91aa8849-7f86-45ce-b471-6f843c22e55a",
      "name": "Ping Target App (With 3x Retry)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        32,
        16
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const startedAt = $('Start Latency Timer').first().json.check_started_at;\nconst res = $input.first().json;\nconst statusCode = res.statusCode || (res.error ? 503 : 200);\nconst responseTimeMs = Date.now() - startedAt;\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.checks = staticData.checks || [];\nstaticData.checks.push({ ts: Date.now(), statusCode, responseTimeMs });\n// Keep last 288 checks (24h at 5-min intervals)\nif (staticData.checks.length > 288) staticData.checks.shift();\n\nconst total = staticData.checks.length;\nconst healthy = staticData.checks.filter(c => c.statusCode === 200).length;\nconst avgLatencyMs = Math.round(staticData.checks.reduce((s, c) => s + c.responseTimeMs, 0) / total);\n\nreturn [{\n  json: {\n    target_url: 'https://demo.realworld.io',\n    status_code: statusCode,\n    response_time_ms: responseTimeMs,\n    rolling_24h_uptime_pct: ((healthy / total) * 100).toFixed(2) + '%',\n    rolling_24h_avg_latency_ms: avgLatencyMs,\n    checked_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "e24e4195-313f-4fa0-884b-aea9b43a8040",
      "name": "Compute Latency & 24h Rolling Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        16
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "status-not-200",
              "leftValue": "={{ $json.status_code }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6056b586-2166-4fb7-a6a6-8df38b36b11a",
      "name": "IF Status != 200",
